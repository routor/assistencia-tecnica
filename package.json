{
  "name": "landing-assistencia-tecnica",
  "version": "0.1.0",
  "private": true,
  "description": "Honest Brazilian Portuguese demand-validation landing for small bench/workshop repair businesses (validation project, not a SaaS).",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
