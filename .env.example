# Environment contract (CTR-003). Descriptive PLACEHOLDERS ONLY.
# Never commit real values or secrets. Copy to `.env.local` (git-ignored) and fill locally.
# Server-only secrets must never be exposed to the client bundle.

# --- Secrets (server-only) ---
# Pooled PostgreSQL URL for a least-privilege application role. Fails closed if missing/invalid.
DATABASE_URL="postgresql://app_user:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/assistencia_tecnica?sslmode=disable"

# Isolated disposable PostgreSQL for integration tests. NEVER point this at production.
TEST_DATABASE_URL="postgresql://app_user:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/assistencia_tecnica_test?sslmode=disable"

# --- Public (safe to expose to the client) ---
# Absolute HTTPS origin used for canonical/social metadata. Required for preview/production.
NEXT_PUBLIC_SITE_URL="https://example.com"

# Google Tag Manager container ID (format GTM-XXXXXXX). Absent = analytics disabled locally,
# but the campaign release gate stays BLOCKED until a real container is configured.
NEXT_PUBLIC_GTM_ID=""

# --- Public policy content (server-read). Approved values required BEFORE production. ---
# Leaving these empty keeps the privacy page in "fail-closed / not-for-production" mode.
PRIVACY_CONTROLLER_NAME=""
PRIVACY_CONTACT=""
# Positive integer, owner/legal-approved. Empty = retention not yet defined (production blocked).
LEAD_RETENTION_DAYS=""
