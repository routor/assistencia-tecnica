# Environment contract (CTR-003).
# Never commit real secrets. Copy to `.env.local` (git-ignored) and/or Vercel env.
# Server-only secrets must never be exposed to the client bundle.
# Owner decisions: specs/003-landing-assistencia-tecnica/owner-decisions-2026-07-10.md

# --- Secrets (server-only) ---
# PD-001: Neon PostgreSQL. Use isolated Neon branches for Production vs Preview.
# Distinct DATABASE_URL per Vercel Production and Preview. NEVER create NEXT_PUBLIC_DATABASE_URL.
DATABASE_URL="postgresql://app_user:REPLACE_WITH_NEON_OR_LOCAL_PASSWORD@localhost:5432/assistencia_tecnica?sslmode=require"

# Isolated disposable PostgreSQL for integration tests. NEVER point this at production/preview.
TEST_DATABASE_URL="postgresql://app_user:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/assistencia_tecnica_test?sslmode=disable"

# --- Public (safe to expose to the client) ---
# PD-004 PARTIAL: Preview may use the real Vercel URL (keep Preview noindex).
# Campaign BLOCKED until a real canonical production origin is set (do not invent).
NEXT_PUBLIC_SITE_URL="https://example.com"

# PD-004: Real GTM ID required before campaign. Absent = analytics disabled; do not invent.
# GA4 and Google Ads are configured inside GTM; consent mechanism remains mandatory.
NEXT_PUBLIC_GTM_ID=""

# --- Public policy content (server-read). PD-003 RESOLVED 2026-07-10. ---
PRIVACY_CONTROLLER_NAME="Rafael Outor, responsável pelo projeto Assistência Técnica Pro."
PRIVACY_CONTACT="rafael.outor@gmail.com"
LEAD_RETENTION_DAYS="180"
